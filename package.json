{
  "name": "rreadnote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run tauri dev",
    "prebuild": "npm run clean:build-cache",
    "build": "npm run tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cli": "cargo run --quiet --manifest-path ./src-tauri/Cargo.toml --",
    "cli:smoke": "node ./scripts/cli-smoke.mjs",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "rust-check": "cargo check --manifest-path ./src-tauri/Cargo.toml",
    "size": "du -sh ./target ./dist 2>/dev/null || true",
    "clean:build-cache": "cargo clean --manifest-path ./src-tauri/Cargo.toml -p rreadnote && rm -rf ./dist ./target/release/bundle",
    "clean": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist",
    "clean:all": "cargo clean --manifest-path ./src-tauri/Cargo.toml && rm -rf ./dist ./node_modules"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "mermaid": "^11.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
