{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rReadNote",
  "version": "0.1.0",
  "identifier": "app.rseries.rreadnote",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1434",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rReadNote",
        "width": 1420,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
